generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String           @id @default(uuid())
  email            String           @unique
  name             String
  passwordHash     String
  role             Role             @default(CLEARING_STAFF)
  isActive         Boolean          @default(true)
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  auditLogs        AuditLog[]
  documents        Document[]

  @@map("users")
}

model Party {
  id                    String                @id @default(uuid())
  partyCode             String                @unique
  companyName           String
  ntn                   String                @unique
  strn                  String?
  companyRegistrationNo String?
  contactPerson         String
  phone                 String
  email                 String
  address               String
  city                  String
  businessType          String
  isActive              Boolean               @default(true)
  notes                 String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  analysisCertificates  AnalysisCertificate[]
  documents             Document[]
  exportGds             ExportGd[]
  importGds             ImportGd[]
  inputMaterials        InputMaterial[]
  reconciliations       Reconciliation[]

  @@index([companyName])
  @@index([ntn])
  @@map("parties")
}

model Vendor {
  id            String   @id @default(uuid())
  vendorName    String
  contactPerson String?
  phone         String
  email         String?
  address       String?
  ntn           String?
  strn          String?
  services      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("vendors")
}

model HsCode {
  id          String   @id @default(uuid())
  code        String   @unique
  description String
  cdRate      Decimal  @db.Decimal(5, 2)
  stRate      Decimal  @db.Decimal(5, 2)
  acdRate     Decimal  @db.Decimal(5, 2)
  rdRate      Decimal  @db.Decimal(5, 2)
  itRate      Decimal  @db.Decimal(5, 2)
  unit        String   @default("Kg")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("hs_codes")
}

model ImportGd {
  id                   String         @id @default(uuid())
  gdNumber             String         @unique
  gdDate               DateTime
  partyId              String
  supplierName         String
  countryOfOrigin      String
  portOfDischarge      String
  blNumber             String?
  totalAssessableValue Decimal        @db.Decimal(15, 2)
  totalDutyTaxes       Decimal        @db.Decimal(15, 2)
  remarks              String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  documents            Document[]
  exportGds            ExportGd[]
  items                ImportGdItem[]
  party                Party          @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([gdNumber])
  @@index([partyId])
  @@index([gdDate])
  @@map("import_gds")
}

model ImportGdItem {
  id              String          @id @default(uuid())
  importGdId      String
  itemDescription String
  hsCode          String
  inputPct        String
  quantity        Decimal         @db.Decimal(15, 6)
  unit            String          @default("Kg")
  importValueVal  Decimal         @db.Decimal(15, 2)
  unitPrice       Decimal?        @db.Decimal(15, 2)
  currency        String          @default("USD")
  exchangeRate    Decimal         @db.Decimal(10, 4)
  assessableValue Decimal         @db.Decimal(15, 2)
  customsDuty     Decimal         @db.Decimal(15, 2)
  salesTax        Decimal         @db.Decimal(15, 2)
  additionalCd    Decimal         @db.Decimal(15, 2)
  regulatoryDuty  Decimal         @db.Decimal(15, 2)
  incomeTax       Decimal         @db.Decimal(15, 2)
  otherTaxes      Decimal         @default(0.00) @db.Decimal(15, 2)
  totalDutyTaxes  Decimal         @db.Decimal(15, 2)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  importGd        ImportGd        @relation(fields: [importGdId], references: [id], onDelete: Cascade)
  inputMaterials  InputMaterial[]

  @@map("import_gd_items")
}

model ExportGd {
  id                    String               @id @default(uuid())
  exportGdNumber        String
  date                  DateTime             @default(now())
  partyId               String
  importGdId            String?
  importGdNumber        String
  analysisCertificateId String?              
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  documents             Document[]
  items                 ExportGdItem[]
  analysisCertificate   AnalysisCertificate? @relation(fields: [analysisCertificateId], references: [id], onDelete: Cascade)
  importGd              ImportGd?            @relation(fields: [importGdId], references: [id])
  party                 Party                @relation(fields: [partyId], references: [id], onDelete: Cascade)
  reconciliations       ReconciliationItem[]

  @@unique([exportGdNumber, partyId])
  @@index([exportGdNumber])
  @@index([partyId])
  @@map("export_gds")
}

model ExportGdItem {
  id                    String               @id @default(uuid())
  exportGdId            String
  serialNo              Int                  @default(1)
  exportHsCode          String
  exportParticulars     String
  qtyOfExports          Decimal              @db.Decimal(15, 6)
  valueOfeExports       Decimal              @db.Decimal(15, 6)
  unit                  String               @default("KG")
  importHsCode          String
  inputValue            Decimal              @db.Decimal(15, 6)
  wastageValue          Decimal              @db.Decimal(15, 6)
  consumedQty           Decimal              @db.Decimal(15, 6)
  wastageQty            Decimal              @db.Decimal(15, 6)
  analysisCertNo        String?
  analysisCertificateId String?              
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  exportGd              ExportGd             @relation(fields: [exportGdId], references: [id], onDelete: Cascade)
  analysisCertificate   AnalysisCertificate? @relation(fields: [analysisCertificateId], references: [id], onDelete: SetNull) 

  @@map("export_gd_items")
}

model InputMaterial {
  id                 String               @id @default(uuid())
  partyId            String
  importGdItemId     String
  pctCode            String
  description        String
  openingQty         Decimal              @default(0.000000) @db.Decimal(15, 6)
  importedQty        Decimal              @default(0.000000) @db.Decimal(15, 6)
  consumedQty        Decimal              @default(0.000000) @db.Decimal(15, 6)
  wastageQty         Decimal              @default(0.000000) @db.Decimal(15, 6)
  closingQty         Decimal              @default(0.000000) @db.Decimal(15, 6)
  unit               String               @default("Kg")
  importValuePkr     Decimal              @db.Decimal(15, 2)
  iocoRatio          Decimal              @db.Decimal(10, 6)
  standardWastagePct Decimal              @db.Decimal(5, 2)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  importGdItem       ImportGdItem         @relation(fields: [importGdItemId], references: [id], onDelete: Cascade)
  party              Party                @relation(fields: [partyId], references: [id], onDelete: Cascade)
  reconciliations    ReconciliationItem[]

  @@index([partyId])
  @@index([pctCode])
  @@map("input_materials")
}

model Reconciliation {
  id               String               @id @default(uuid())
  reconciliationNo String               @unique
  partyId          String
  statementDate    DateTime             @default(now())
  periodStart      DateTime
  periodEnd        DateTime
  status           ReconciliationStatus @default(PENDING)
  totalImportQty   Decimal              @db.Decimal(15, 6)
  totalExportQty   Decimal              @db.Decimal(15, 6)
  totalWastageQty  Decimal              @db.Decimal(15, 6)
  totalClosingQty  Decimal              @db.Decimal(15, 6)
  overallStatus    String
  notes            String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  items            ReconciliationItem[]
  party            Party                @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId])
  @@map("reconciliations")
}

model ReconciliationItem {
  id                    String               @id @default(uuid())
  reconciliationId      String
  inputMaterialId       String
  exportGdId            String?
  importGdNo            String
  inputDescription      String
  importQtyKg           Decimal              @db.Decimal(15, 6)
  importValuePkr        Decimal              @db.Decimal(15, 2)
  inputPct              String
  analysisCertNo        String?
  netIocoConsumption    Decimal              @db.Decimal(15, 6)
  iocoWastageQty        Decimal              @db.Decimal(15, 6)
  grossIocoConsumption  Decimal              @db.Decimal(15, 6)
  wastagePercentage     Decimal              @db.Decimal(5, 2)
  exportGdNo            String?
  exportDescription     String?
  exportQtyKg           Decimal              @default(0.000000) @db.Decimal(15, 6)
  exportValuePkr        Decimal              @default(0.00) @db.Decimal(15, 2)
  consumptionIncWastage Decimal              @default(0.000000) @db.Decimal(15, 6)
  actualWastageKg       Decimal              @default(0.000000) @db.Decimal(15, 6)
  closingBalanceKg      Decimal              @default(0.000000) @db.Decimal(15, 6)
  valueAddition         Decimal              @default(0.00) @db.Decimal(10, 2)
  unitClaim             Decimal?             @db.Decimal(15, 6)
  calculatedDifference  Decimal?             @db.Decimal(15, 6)
  itemStatus            ReconciliationStatus @default(PENDING)
  exportGd              ExportGd?            @relation(fields: [exportGdId], references: [id])
  inputMaterial         InputMaterial        @relation(fields: [inputMaterialId], references: [id], onDelete: Cascade)
  reconciliation        Reconciliation       @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)

  @@map("reconciliation_items")
}

model Document {
  id           String           @id @default(uuid())
  fileName     String
  fileUrl      String
  fileType     String
  category     DocumentCategory
  partyId      String?
  importGdId   String?
  exportGdId   String?
  uploadedById String
  uploadedAt   DateTime         @default(now())
  exportGd     ExportGd?        @relation(fields: [exportGdId], references: [id])
  importGd     ImportGd?        @relation(fields: [importGdId], references: [id])
  party        Party?           @relation(fields: [partyId], references: [id])
  uploadedBy   User             @relation(fields: [uploadedById], references: [id])

  @@map("documents")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entity    String
  entityId  String
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model AnalysisCertificate {
  id                String             @id @default(uuid())
  certificateNumber String             @unique
  partyId           String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  items             AnalysisCertItem[]
  party             Party              @relation(fields: [partyId], references: [id], onDelete: Cascade)
  exportGds         ExportGd[]
  exportGdItems     ExportGdItem[]     

  @@map("analysis_certificates")
}

model AnalysisCertItem {
  id                    String              @id @default(uuid())
  analysisCertificateId String
  serialNo              Int                 @default(1)
  hsCode                String
  itemDescription       String
  uom                   String              @default("KG")
  requirementQty        Decimal             @db.Decimal(15, 6)
  wastageQty            Decimal             @db.Decimal(15, 6)
  inputWithWastage      Decimal             @db.Decimal(15, 6)
  wastagePct            Decimal             @db.Decimal(8, 4)
  analysisCertificate   AnalysisCertificate @relation(fields: [analysisCertificateId], references: [id], onDelete: Cascade)

  @@map("analysis_cert_items")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CLEARING_STAFF
  ACCOUNTS
  VIEWER
}

enum DocumentCategory {
  GOODS_DECLARATION
  INVOICE
  PACKING_LIST
  BILL_OF_LADING
  FORM_E
  CERTIFICATE_OF_ORIGIN
  AUTHORIZATION_LETTER
  NTN_STRN_CERTIFICATE
  IOCO_ANALYSIS_CARD
  OTHER
}

enum ReconciliationStatus {
  RECONCILED
  PARTIALLY_RECONCILED
  PENDING
  SHORT
  EXCESS
  ATTENTION_REQUIRED
}
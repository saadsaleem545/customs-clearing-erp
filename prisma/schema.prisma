datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------
// ENUMS
// ------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  CLEARING_STAFF
  ACCOUNTS
  VIEWER
}

enum ClearingStatus {
  DRAFT
  SUBMITTED
  UNDER_PROCESSING
  ASSESSED
  CLEARED
  COMPLETED
  CANCELLED
}

enum DocumentCategory {
  GOODS_DECLARATION
  INVOICE
  PACKING_LIST
  BILL_OF_LADING
  FORM_E
  CERTIFICATE_OF_ORIGIN
  AUTHORIZATION_LETTER
  NTN_STRN_CERTIFICATE
  IOCO_ANALYSIS_CARD
  OTHER
}

enum PaymentMethod {
  CASH
  CHEQUE
  BANK_TRANSFER
  PAY_ORDER
  ONLINE
}

enum ReconciliationStatus {
  RECONCILED
  PARTIALLY_RECONCILED
  PENDING
  SHORT
  EXCESS
  ATTENTION_REQUIRED
}

// ------------------------------------------------------
// USER MANAGEMENT & RBAC
// ------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(CLEARING_STAFF)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  auditLogs    AuditLog[]
  documents    Document[]

  @@map("users")
}

// ------------------------------------------------------
// PARTY / CLIENT MASTER
// ------------------------------------------------------

model Party {
  id                    String   @id @default(uuid())
  partyCode             String   @unique
  companyName           String
  ntn                   String   @unique
  strn                  String?
  companyRegistrationNo String?
  contactPerson         String
  phone                 String
  email                 String
  address               String
  city                  String
  businessType          String
  isActive              Boolean  @default(true)
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  importGds             ImportGd[]     
  exportGds             ExportGd[]     
  inputMaterials        InputMaterial[] 
  reconciliations       Reconciliation[] 
  documents             Document[]     
  invoices              Invoice[]      
  expenses              Expense[]      
  payments              Payment[]      
  ledgers               PartyLedger[]  
  analysisCertificates  AnalysisCertificate[]

  @@index([companyName])
  @@index([ntn])
  @@map("parties")
}

// ------------------------------------------------------
// MASTER DATA & VENDORS
// ------------------------------------------------------

model Vendor {
  id            String    @id @default(uuid())
  vendorName    String
  contactPerson String?
  phone         String
  email         String?
  address       String?
  ntn           String?
  strn          String?
  services      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  expenses      Expense[]

  @@map("vendors")
}

model HsCode {
  id          String   @id @default(uuid())
  code        String   @unique
  description String
  cdRate      Decimal  @db.Decimal(5, 2)
  stRate      Decimal  @db.Decimal(5, 2)
  acdRate     Decimal  @db.Decimal(5, 2)
  rdRate      Decimal  @db.Decimal(5, 2)
  itRate      Decimal  @db.Decimal(5, 2)
  unit        String   @default("Kg")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("hs_codes")
}

// ------------------------------------------------------
// IMPORT OPERATIONS
// ------------------------------------------------------

model ImportGd {
  id                   String         @id @default(uuid())
  gdNumber             String         @unique
  gdDate               DateTime
  partyId              String
  supplierName         String
  countryOfOrigin      String
  portOfDischarge      String
  blNumber             String?
  status               ClearingStatus @default(DRAFT)
  totalAssessableValue Decimal        @db.Decimal(15, 2)
  totalDutyTaxes       Decimal        @db.Decimal(15, 2)
  remarks              String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  party                Party          @relation(fields: [partyId], references: [id], onDelete: Cascade)
  items                ImportGdItem[]
  exportGds            ExportGd[]     
  documents            Document[]
  expenses             Expense[]

  @@index([gdNumber])
  @@index([partyId])
  @@index([gdDate])
  @@map("import_gds")
}

model ImportGdItem {
  id              String          @id @default(uuid())
  importGdId      String
  itemDescription String
  hsCode          String
  inputPct        String
  quantity        Decimal         @db.Decimal(12, 3)
  unit            String          @default("Kg")
  importValueVal  Decimal         @db.Decimal(15, 2)
  unitPrice       Decimal?        @db.Decimal(15, 2)
  currency        String          @default("USD")
  exchangeRate    Decimal         @db.Decimal(10, 4)
  assessableValue Decimal         @db.Decimal(15, 2)
  customsDuty     Decimal         @db.Decimal(15, 2)
  salesTax        Decimal         @db.Decimal(15, 2)
  additionalCd    Decimal         @db.Decimal(15, 2)
  regulatoryDuty  Decimal         @db.Decimal(15, 2)
  incomeTax       Decimal         @db.Decimal(15, 2)
  otherTaxes      Decimal         @default(0.00) @db.Decimal(15, 2)
  totalDutyTaxes  Decimal         @db.Decimal(15, 2)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  importGd        ImportGd        @relation(fields: [importGdId], references: [id], onDelete: Cascade)
  inputMaterials  InputMaterial[]

  @@map("import_gd_items")
}

// ------------------------------------------------------
// EXPORT OPERATIONS
// ------------------------------------------------------

model ExportGd {
  id                    String              @id @default(uuid())
  exportGdNumber        String              @unique
  date                  DateTime            @default(now())
  partyId               String
  importGdId            String?
  importGdNumber        String
  analysisCertificateId String
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  party                 Party               @relation(fields: [partyId], references: [id], onDelete: Cascade)
  importGd              ImportGd?           @relation(fields: [importGdId], references: [id], onDelete: SetNull)
  analysisCertificate   AnalysisCertificate @relation(fields: [analysisCertificateId], references: [id], onDelete: Cascade)
  items                 ExportGdItem[]
  documents             Document[]
  reconciliations       ReconciliationItem[]

  @@index([exportGdNumber])
  @@index([partyId])
  @@map("export_gds")
}

model ExportGdItem {
  id                String   @id @default(uuid())
  exportGdId        String
  serialNo          Int      @default(1)
  exportHsCode      String
  exportParticulars String
  qtyOfExports      Decimal  @db.Decimal(12, 4)
  valueOfeExports   Decimal  @db.Decimal(12, 4)
  importHsCode      String
  inputValue        Decimal  @db.Decimal(12, 4)
  wastageValue      Decimal  @db.Decimal(12, 4)
  consumedQty       Decimal  @db.Decimal(12, 4)
  wastageQty        Decimal  @db.Decimal(12, 4)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  exportGd          ExportGd @relation(fields: [exportGdId], references: [id], onDelete: Cascade)

  @@map("export_gd_items")
}

// ------------------------------------------------------
// INVENTORY & MATERIAL LEDGER
// ------------------------------------------------------

model InputMaterial {
  id                 String   @id @default(uuid())
  partyId            String
  importGdItemId     String
  pctCode            String
  description        String
  openingQty         Decimal  @default(0.000) @db.Decimal(12, 3)
  importedQty        Decimal  @db.Decimal(12, 3)
  consumedQty        Decimal  @default(0.000) @db.Decimal(12, 3)
  wastageQty         Decimal  @default(0.000) @db.Decimal(12, 3)
  closingQty         Decimal  @db.Decimal(12, 3)
  unit               String   @default("Kg")
  importValuePkr     Decimal  @db.Decimal(15, 2)
  iocoRatio          Decimal  @db.Decimal(10, 6)
  standardWastagePct Decimal  @db.Decimal(5, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  party              Party                 @relation(fields: [partyId], references: [id], onDelete: Cascade)
  importGdItem       ImportGdItem          @relation(fields: [importGdItemId], references: [id], onDelete: Cascade)
  materialLedgers    MaterialTransaction[]
  reconciliations    ReconciliationItem[]

  @@index([partyId])
  @@index([pctCode])
  @@map("input_materials")
}

model MaterialTransaction {
  id              String   @id @default(uuid())
  inputMaterialId String
  exportGdNumber  String?
  transactionDate DateTime @default(now())
  transactionType String
  quantityOut     Decimal  @db.Decimal(12, 3)
  balanceAfter    Decimal  @db.Decimal(12, 3)
  referenceNo     String
  remarks         String?

  inputMaterial   InputMaterial @relation(fields: [inputMaterialId], references: [id], onDelete: Cascade)

  @@map("material_transactions")
}

// ------------------------------------------------------
// RECONCILIATION ENGINE (IOR)
// ------------------------------------------------------

model Reconciliation {
  id               String               @id @default(uuid())
  reconciliationNo String               @unique
  partyId          String
  statementDate    DateTime             @default(now())
  periodStart      DateTime
  periodEnd        DateTime
  status           ReconciliationStatus @default(PENDING)
  totalImportQty   Decimal              @db.Decimal(12, 3)
  totalExportQty   Decimal              @db.Decimal(12, 3)
  totalWastageQty  Decimal              @db.Decimal(12, 3)
  totalClosingQty  Decimal              @db.Decimal(12, 3)
  overallStatus    String
  notes            String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  party            Party                @relation(fields: [partyId], references: [id], onDelete: Cascade)
  items            ReconciliationItem[]

  @@index([partyId])
  @@map("reconciliations")
}

model ReconciliationItem {
  id                    String               @id @default(uuid())
  reconciliationId      String
  inputMaterialId       String
  exportGdId            String?
  importGdNo            String
  inputDescription      String
  importQtyKg           Decimal              @db.Decimal(12, 3)
  importValuePkr        Decimal              @db.Decimal(15, 2)
  inputPct              String
  analysisCertNo        String?
  netIocoConsumption    Decimal              @db.Decimal(12, 3)
  iocoWastageQty        Decimal              @db.Decimal(12, 3)
  grossIocoConsumption  Decimal              @db.Decimal(12, 3)
  wastagePercentage     Decimal              @db.Decimal(5, 2)
  exportGdNo            String?
  exportDescription     String?
  exportQtyKg           Decimal              @default(0.000) @db.Decimal(12, 3)
  exportValuePkr        Decimal              @default(0.00) @db.Decimal(15, 2)
  consumptionIncWastage Decimal              @default(0.000) @db.Decimal(12, 3)
  actualWastageKg       Decimal              @default(0.000) @db.Decimal(12, 3)
  closingBalanceKg      Decimal              @default(0.000) @db.Decimal(12, 3)
  valueAddition         Decimal              @default(0.00) @db.Decimal(10, 2)
  unitClaim             Decimal              @db.Decimal(12, 4)
  calculatedDifference  Decimal              @db.Decimal(12, 3)
  itemStatus            ReconciliationStatus

  reconciliation        Reconciliation       @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  inputMaterial         InputMaterial        @relation(fields: [inputMaterialId], references: [id], onDelete: Cascade)
  exportGd              ExportGd?            @relation(fields: [exportGdId], references: [id], onDelete: SetNull)

  @@map("reconciliation_items")
}

// ------------------------------------------------------
// FINANCIALS, EXPENSES & BILLING
// ------------------------------------------------------

model Invoice {
  id              String        @id @default(uuid())
  invoiceNumber   String        @unique
  partyId         String
  invoiceDate     DateTime      @default(now())
  dueDate         DateTime
  clearingCharges Decimal       @db.Decimal(15, 2)
  agencyFee       Decimal       @db.Decimal(15, 2)
  reimbursableExp Decimal       @db.Decimal(15, 2)
  totalAmount     Decimal       @db.Decimal(15, 2)
  paidAmount      Decimal       @default(0.00) @db.Decimal(15, 2)
  balanceDue      Decimal       @db.Decimal(15, 2)
  isPaid          Boolean       @default(false)
  remarks         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  party           Party         @relation(fields: [partyId], references: [id], onDelete: Cascade)
  items           InvoiceItem[]
  payments        Payment[]

  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  amount      Decimal @db.Decimal(15, 2)

  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model Expense {
  id            String        @id @default(uuid())
  expenseNumber String        @unique
  partyId       String?
  importGdId    String?
  vendorId      String?
  expenseDate   DateTime
  expenseType   String
  amount        Decimal       @db.Decimal(15, 2)
  paymentMethod PaymentMethod @default(BANK_TRANSFER)
  isPaid        Boolean       @default(true)
  description   String?
  receiptUrl    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  party         Party?        @relation(fields: [partyId], references: [id], onDelete: SetNull)
  importGd      ImportGd?     @relation(fields: [importGdId], references: [id], onDelete: SetNull)
  vendor        Vendor?       @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@map("expenses")
}

model Payment {
  id            String        @id @default(uuid())
  paymentNo     String        @unique
  partyId       String
  invoiceId     String?
  paymentDate   DateTime      @default(now())
  amount        Decimal       @db.Decimal(15, 2)
  paymentMethod PaymentMethod
  referenceNo   String?
  remarks       String?
  createdAt     DateTime      @default(now())

  party         Party         @relation(fields: [partyId], references: [id], onDelete: Cascade)
  invoice       Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@map("payments")
}

model PartyLedger {
  id              String   @id @default(uuid())
  partyId         String
  transactionDate DateTime @default(now())
  voucherNo       String
  description     String
  debit           Decimal  @default(0.00) @db.Decimal(15, 2)
  credit          Decimal  @default(0.00) @db.Decimal(15, 2)
  balance         Decimal  @db.Decimal(15, 2)

  party           Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@map("party_ledgers")
}

// ------------------------------------------------------
// DOCUMENTS & AUDIT TRAIL
// ------------------------------------------------------

model Document {
  id           String           @id @default(uuid())
  fileName     String
  fileUrl      String
  fileType     String
  category     DocumentCategory
  partyId      String?
  importGdId   String?
  exportGdId   String?
  uploadedById String
  uploadedAt   DateTime         @default(now())

  party        Party?           @relation(fields: [partyId], references: [id], onDelete: SetNull)
  importGd     ImportGd?        @relation(fields: [importGdId], references: [id], onDelete: SetNull)
  exportGd     ExportGd?        @relation(fields: [exportGdId], references: [id], onDelete: SetNull)
  uploadedBy   User             @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@map("documents")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entity    String
  entityId  String
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("audit_logs")
}

// ------------------------------------------------------
// ANALYSIS CERTIFICATES (IOCO / EFS)
// ------------------------------------------------------

model AnalysisCertificate {
  id                String              @id @default(uuid())
  certificateNumber String              @unique
  partyId           String
  party             Party               @relation(fields: [partyId], references: [id], onDelete: Cascade)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  items             AnalysisCertItem[]
  exportGds         ExportGd[]

  @@map("analysis_certificates")
}

model AnalysisCertItem {
  id                    String              @id @default(uuid())
  analysisCertificateId String
  analysisCertificate   AnalysisCertificate @relation(fields: [analysisCertificateId], references: [id], onDelete: Cascade)
  serialNo              Int                 @default(1)
  hsCode                String
  itemDescription       String
  uom                   String              @default("KG")
  requirementQty        Decimal             @db.Decimal(12, 4)
  wastageQty            Decimal             @db.Decimal(12, 4)
  inputWithWastage      Decimal             @db.Decimal(12, 4)
  wastagePct            Decimal             @db.Decimal(8, 4)

  @@map("analysis_cert_items")
}